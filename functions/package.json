{
  "name": "nakuadiary-functions",
  "description": "Cloud Functions backing the Nakuadiary storefront: guest cart checkout via Paystack and order fulfillment.",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "seed": "node seed.js",
    "create-admin": "node create-admin.js",
    "serve": "firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell",
    "logs": "firebase functions:log",
    "test": "firebase emulators:exec --project demo-nakuadiary --only firestore,auth,storage \"node --test --test-concurrency=1 test/*.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
