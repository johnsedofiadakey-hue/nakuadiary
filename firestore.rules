rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // products/{productId} — public catalog, admin-managed.
    // Evaluated per-document for both get and list, so a list query only
    // ever returns documents the caller is allowed to see.
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // carts/{uid} — owner-only, device-scoped guest or signed-in cart.
    match /carts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // The rules language has no loop/map construct, so per-line field
      // and quantity-cap validation can't be expressed here — only the
      // top-level shape is enforced. createCheckout is the authority: it
      // re-reads canonical product/variant price and availability from
      // Firestore and ignores any client-supplied price or quantity that
      // doesn't hold up, per the contract's "server enforces stock" rule.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lines', 'updatedAt'])
        && request.resource.data.lines is list
        && request.resource.data.lines.size() <= 50;
    }

    // orders/{orderId} — server-created only (Cloud Functions via Admin SDK).
    // Status changes go through the updateOrderStatus callable, never a
    // direct write, so the state machine is enforced in one place.
    match /orders/{orderId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.buyerUid) || isAdmin();
      allow write: if false;

      // Append-only audit trail of every status change (functions only).
      match /events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // smsOutbox/{orderId_status} — one doc per order SMS, written and sent by
    // functions only. Admins can see delivery state; re-sends go through the
    // resendOrderSms callable.
    match /smsOutbox/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // paystackEvents/{eventKey} — webhook de-duplication log (functions only).
    match /paystackEvents/{eventKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // config/sms — admin-editable SMS sender ID, templates and on/off switch.
    // Never readable by the public; never holds API keys (those are
    // Secret Manager secrets on the functions).
    match /config/{docId} {
      allow read: if isAdmin() && docId == 'sms';
      allow write: if isAdmin() && docId == 'sms'
        && request.resource.data.keys().hasOnly(['enabled', 'senderId', 'templates', 'ownerPhone', 'ownerAlerts', 'updatedAt', 'updatedBy'])
        && (!('senderId' in request.resource.data) || (request.resource.data.senderId is string && request.resource.data.senderId.size() <= 11))
        && (!('enabled' in request.resource.data) || request.resource.data.enabled is bool)
        && (!('ownerAlerts' in request.resource.data) || request.resource.data.ownerAlerts is bool)
        && (!('ownerPhone' in request.resource.data) || (request.resource.data.ownerPhone is string && request.resource.data.ownerPhone.size() <= 24))
        && (!('templates' in request.resource.data) || (request.resource.data.templates is map
            && request.resource.data.templates.keys().hasOnly(['paid', 'processing', 'dispatched', 'delivered', 'owner'])));
    }

    // customers/{customerId} — admin-only. Contains business data
    // (totalSpent, notes) never exposed to the customer it describes; a
    // wholesale buyer's own history is read through orders instead.
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // site/{docId} — storefront content edited from /admin → Homepage and
    // Settings. Public read (every visitor renders it); admin-only write,
    // limited to the two known docs. Shapes: dist/js/site-content.js.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId in ['settings', 'home'];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
